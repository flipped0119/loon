#!name=微信公众号去广告补充
#!desc=配合常用的微信公众号去广告插件使用，只补它们没处理的接口（5 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!tag=去广告
#!loon_version=3.5.1(998)

[Rewrite]
^https?:\/\/mp\.weixin\.qq.com\/mp\/ad_complaint - reject
^https?:\/\/mp\.weixin\.qq.com\/mp\/ad_video - reject
^https?:\/\/mp\.weixin\.qq.com\/mp\/advertisement_report - reject
request if ${url} ~= /^https?:\/\/mp\.weixin\.qq\.com\/wapad\/getaddata\?action=getad/ then reject(200)
request if ${url} ~= /^https?:\/\/mp\.weixin\.qq\.com\/wapad\/reportaddata\?action=exposure_report/ then reject(200)

[MitM]
hostname=mp.weixin.qq.com
