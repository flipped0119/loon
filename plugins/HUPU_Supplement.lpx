#!name=虎扑去广告补充
#!desc=配合常用的虎扑去广告插件使用，只补它们没处理的接口（6 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!openUrl=https://apps.apple.com/app/id906632439
#!author=flipped0119
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/ac/ca/fa/accafa4d-5022-5d2b-5060-a5b3ba27761f/AppIcon-0-0-1x_U007emarketing-0-8-0-sRGB-85-220.png/120x120bb.png
#!date=2026-10-22 19:30:26

[Rewrite]
request if ${url} ~= /^https?:\/\/games\.mobileapi\.hupu\.com\/.+\/(search|interfaceAdMonitor|status|hupuBbsPm)\/(hotkey|init|hupuBbsPm)\./i then reject_img(200)
request if ${url} ~= /^https?:\/\/games\.mobileapi\.hupu\.com\/interfaceAdMonitor/i then reject_img(200)
request if ${url} ~= /^https?:\/\/goblin\.hupu\.com\/.+\/interfaceAd\/getOther/i then reject(200)
request if ${url} ~= /^https?:\/\/games\.mobileapi\.hupu\.com\/.+?\/(interfaceAdMonitor|interfaceAd)\//i then reject(404)
request if ${url} ~= /^https?:\/\/games\.mobileapi\.hupu\.com\/.+?\/status\/init/i then reject(404)
request if ${url} ~= /^https?:\/\/goblin\.hupu\.com\/.+\/interfaceAd\//i then reject(404)

[MitM]
hostname=games.mobileapi.hupu.com, goblin.hupu.com
