#!name=淘宝去广告补充
#!desc=配合常用的淘宝去广告插件使用，只补它们没处理的接口（22 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!openUrl=https://apps.apple.com/app/id387682726
#!author=flipped0119
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/d4/b1/4a/d4b14a2f-73e2-a36d-49e7-ff8492fa7e06/AppIcon-0-0-1x_U007emarketing-0-10-0-85-220.png/120x120bb.png
#!date=2026-10-22 19:30:26

[Rewrite]
response if ${url} ~= /https:\/\/acs.m.taobao.com\/gw\/mtop.film.independentadvertiseapi.querypreloadadvertise/i then response.json.jq(".data.returnValue=[]")
response if ${url} ~= /https:\/\/acs.m.taobao.com\/gw\/mtop.film.mtopsearchapi.getranklistbytypeforsearch/i then response.json.jq(".data.returnValue={}")
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.cbu\.app\.homepage\.startup/i then reject(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.availablesplashstrategies/i then reject(200)
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.mos\.app\.homepage\.launch/i then reject(200)
request if ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.fc\.resource\.tacdata\.get/i then reject(200)
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.aicloud\.splash/i then reject(200)
response if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba.*mytab/i then response.json.jq(".data.model.children |= map(select(.name | contains(\"营销\") | not))")
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query.*etao_splash/i then reject(200)
request if ${url} ~= /^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.tmall\.wireless/i then reject(200)
request if ${url} ~= /^https:\/\/(heic|gw)\.alicdn\.com\/imgextra\/i\d\/.+-tps-(702-758|1125-1602)\.(heic|jpg|png)/i then reject(200)
request if ${url} ~= /^https?:\/\/heic\.alicdn\.com\/tps\/i4\/.+?\.jpg_1200x1200q90\.jpg_\.heic$/i then reject(200)
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.exposure\.get\//i then reject(404)
request if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.hippotown\.tabbar\.info/i then reject(404)
request if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.crm\.platform\.ma\.recommend/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.wdk\.mimir\.recommend\.after\.purchase\.activity/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.guide\.guess\.what\.you\.like/i then reject(404)
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.tripbaymax\.busi\.buyer\.promote\.track/i then reject(404)
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.traffic\.ai\.chat\.init/i then reject(404)
request if ${url} ~= /^https?:\/\/acs(\.|-)m\.(taobao|freshippo)\.com\/gw\/mtop\.alibaba\.emas\.publish\.update\.get/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.ssif\.pattern\.home/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/fliggy.js") with tag="淘宝去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.traveldetail\.ultron\.detail\.firstscreen\.get/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/fliggy.js") with tag="淘宝去广告补充", requires_body=true

[MitM]
hostname=acs.m.taobao.com, guide-acs.m.taobao.com, heic.alicdn.com
