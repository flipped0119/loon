#!name=马蜂窝去广告补充
#!desc=配合常用的马蜂窝去广告插件使用，只补它们没处理的接口（7 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/06/e8/db/06e8db14-b083-dcef-b660-9a72950734cb/AppIcon-0-0-1x_U007emarketing-0-8-0-sRGB-85-220.png/120x120bb.png
#!openUrl=https://apps.apple.com/app/id406596432
#!tag=去广告
#!date=2026-10-22 16:38:18
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https:\/\/mapi.mafengwo.cn\/ad\/get_launch_ad_list\/v2/ then reject(200)
^https?:\/\/mapi\.mafengwo\.cn\/(travelguide\/)?ad reject
^https?:\/\/mapi\.mafengwo\.cn\/widget\/note\/get_widget_note reject
^https?:\/\/mapi\.mafengwo\.cn\/system\/update\/check_update reject-dict
^https?:\/\/mapi\.mafengwo\.cn\/system\/config\/(get|mark)_(push|alert)_config reject-dict
^https?:\/\/mapi\.mafengwo\.cn\/system\/push\/get_local_push_config reject

[Script]
http-response ^https?:\/\/mapi\.mafengwo\.cn\/user\/profile\/get_(list|profile) script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/mafengwo.js, requires-body=true, timeout=60, tag=马蜂窝去广告补充, enable=true

[MitM]
hostname=mapi.mafengwo.cn
