#!name=闲鱼去广告补充
#!desc=配合常用的闲鱼去广告插件使用，只补它们没处理的接口（3 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!tag=去广告
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.*splash\.ads/ then reject(200)
request if ${url} ~= /^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.idle.ad.expose/ then reject(200)

[Script]
response if ${url} ~= /^http:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,4}(:\d+)?\/amdc\/mobileDispatch/ then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amdc.js") with tag="闲鱼补充", requires_body=true

[MitM]
hostname=g-acs.m.goofish.com, acs.m.goofish.com
