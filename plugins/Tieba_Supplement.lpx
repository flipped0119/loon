#!name=百度贴吧去广告补充
#!desc=配合常用的百度贴吧去广告插件使用，只补它们没处理的接口（2 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!tag=去广告
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https?:\/\/tieba(c)?\.baidu\.com\/c\/f\/ad\/getFeedAd/ then reject(200)

[Script]
response if ${url} ~= /^http(s:\/\/tiebac|:\/\/c\.tieba)\.baidu\.com\/c\/f\/(frs\/(page|threadlist|generalTabList)|pb\/page|excellent\/personalized)\?cmd/ then script("https://raw.githubusercontent.com/app2smile/rules/master/js/tieba-proto.js") with tag="百度贴吧补充", requires_body=true

[MitM]
hostname=tiebac.baidu.com, tieba.baidu.com
