#!name=百度贴吧去广告补充
#!desc=配合常用的百度贴吧去广告插件使用，只补它们没处理的接口（6 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/7a/1e/74/7a1e74e5-262e-ef03-55a2-3d55d7eacd11/AppIcon-0-0-1x_U007emarketing-0-8-0-sRGB-85-220.png/120x120bb.png
#!openUrl=https://apps.apple.com/app/id477927812
#!tag=去广告
#!date=2026-10-22 19:21:00
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https?:\/\/tieba(c)?\.baidu\.com\/c\/f\/ad\/getFeedAd/ then reject(200)
request if ${url} ~= /^https:\/\/tiebac\.baidu\.com\/c\/u\/chat\/getChatSubscriptionList/ then reject_dict(200)
response if ${url} ~= /^https:\/\/tiebac\.baidu\.com\/livefeed\/feed/ then response.json.jq("del(.data.banner.items)")

[Script]
response if ${url} ~= /^http(s:\/\/tiebac|:\/\/c\.tieba)\.baidu\.com\/c\/f\/(frs\/(page|threadlist|generalTabList)|pb\/page|excellent\/personalized)\?cmd/ then script("https://raw.githubusercontent.com/app2smile/rules/master/js/tieba-proto.js") with tag="百度贴吧去广告补充", requires_body=true, binary_body_mode=true
response if ${url} ~= /^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/(c\/(s\/sync|f\/(ad\/getSplashAd|frs\/(page|threadlist|generalTabList)|pb\/(pic)?page|excellent\/personalized))$|tiebaads\/commonbatch\?)/ then script("https://raw.githubusercontent.com/app2smile/rules/master/js/tieba-json.js") with tag="百度贴吧去广告补充", requires_body=true, timeout=10
response if ${url} ~= /^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/c\/(b\/ad\/adBid|f\/(frs\/(page|threadlist|generalTabList)|ad\/getFeedAd|pb\/page|excellent\/personalized))\?cmd/ then script("https://raw.githubusercontent.com/app2smile/rules/master/js/tieba-proto.js", "[0]") with tag="百度贴吧去广告补充", requires_body=true, timeout=10, binary_body_mode=true

[MitM]
hostname=tiebac.baidu.com, tieba.baidu.com
