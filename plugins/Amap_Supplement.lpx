#!name=高德地图去广告补充
#!desc=配合常用的高德地图去广告插件使用，只补它们没处理的接口（28 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/74/5a/15/745a1507-ef38-a474-2bbf-66826e29dc09/AppIcon-0-0-1x_U007epad-0-1-0-85-220.png/120x120bb.png
#!openUrl=https://apps.apple.com/app/id461703208
#!tag=去广告
#!date=2026-10-22 17:24:51
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/aos\/alimama\/splash_screen/ then reject(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/v\d\/ai_rec\// then reject_dict(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/card-service-route-plan\?/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/boss\/order_web\/\w{8}_information/ then reject(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/asa\/ads_attribution/ then reject(404)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/uploadimg\/\w+\.gif/ then reject_img(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/valueadded\/weather/ then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv\?/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/m5\.amap\.com\/ws\/shield\/dsp\/app\/startup\/init\?/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/m5-zb\.amap\.com\/ws\/boss\/end\/recommend/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/oss\.amap\.com\/ws\/banner\/lists\/\?/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/m\d-zb\.amap\.com\/ws\/boss\/(order\/car\/king_toolbox_car_bubble|tips\/onscene_visual_optimization)/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/dualstack-(arestapi|restios)\.amap\.com\/v\d\/iasdkauth\?key=/ then reject(200)
request if ${url} ~= /^https?:\/\/dualstack-logs\.amap\.com\/ws\/log\/upload\?product/ then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/message\/notice\/list/ then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/nearbyrec_smart/ then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/msgbox\/pull/ then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/new_hotword/ then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/aos\/perception\/publicTravel\/beforeNavi\?/ then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/bus\/plan\/integrate\?/ then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/c3frontend\/af-(hotel|launch)\/page\/main\?/ then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/perception\/drive\/(?>routeInfo|routePlan)/ then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/search\/(common\/coupon\/info|poi\/detail)/ then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/search_poi\/(homepage|mps|search\/sp|sug|tips_operation_location)/ then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/faas\/amap-navigation\/(?>card-service-plan-home|main-page)/ then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaasv\d\?/ then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d-zb\.amap\.com\/ws\/promotion-web\/resource(\/home)?\?/ then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d-zb\.amap\.com\/ws\/sharedtrip\/taxi\/order_detail_car_tips\?/ then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true

[MitM]
hostname=m5.amap.com, ai.amap.com, amap-aos-info-nogw.amap.com, center.amap.com, m5-zb.amap.com, m*.amap.com, oss.amap.com, dualstack*.amap.com
