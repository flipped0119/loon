#!name=高德地图去广告补充
#!desc=配合常用的高德地图去广告插件使用，只补它们没处理的接口（33 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!openUrl=https://apps.apple.com/app/id461703208
#!author=flipped0119
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/74/5a/15/745a1507-ef38-a474-2bbf-66826e29dc09/AppIcon-0-0-1x_U007epad-0-1-0-85-220.png/120x120bb.png
#!date=2026-10-22 22:27:02

[Rewrite]
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/aos\/alimama\/splash_screen/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/v\d\/ai_rec\//i then reject_dict(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/card-service-route-plan\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/boss\/order_web\/\w{8}_information/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/asa\/ads_attribution/i then reject(404)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/uploadimg\/\w+\.gif/i then reject_img(200)
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/valueadded\/weather/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/m5\.amap\.com\/ws\/shield\/dsp\/app\/startup\/init\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/m5-zb\.amap\.com\/ws\/boss\/end\/recommend/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/oss\.amap\.com\/ws\/banner\/lists\/\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/m\d-zb\.amap\.com\/ws\/boss\/(order\/car\/king_toolbox_car_bubble|tips\/onscene_visual_optimization)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/dualstack-(arestapi|restios)\.amap\.com\/v\d\/iasdkauth\?key=/i then reject(200)
request if ${url} ~= /^https?:\/\/dualstack-logs\.amap\.com\/ws\/log\/upload\?product/i then reject(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/aos\/main\/page\/product\/list\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/c3frontend\/af-comment\/contentNearbyCard\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(?:pay\/web\/paySuccess\/info\/request|transportation\/diversion\/resource\/driving)/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/message\/notice\/list/i then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/nearbyrec_smart/i then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/msgbox\/pull/i then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/new_hotword/i then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/aos\/perception\/publicTravel\/beforeNavi\?/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
