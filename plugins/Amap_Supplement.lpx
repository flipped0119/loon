response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/faas\/amap-navigation\/(?>card-service-plan-home|main-page)/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaasv\d\?/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d-zb\.amap\.com\/ws\/promotion-web\/resource(\/home)?\?/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/m\d-zb\.amap\.com\/ws\/sharedtrip\/taxi\/order_detail_car_tips\?/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/amap.js") with tag="高德地图去广告补充", requires_body=true
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/c3frontend\/(?:af-(?:hotel|launch)\/page\/main|af-nearby\/nearby)/i then script("https://rucu6.pages.dev/Scripts/amap.js") with tag="高德地图去广告补充", requires_body=true
