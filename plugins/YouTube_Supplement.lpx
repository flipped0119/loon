#!name=YouTube去广告补充
#!desc=配合常用的YouTube去广告插件使用，只补它们没处理的接口（3 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!tag=去广告
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads/ then reject(200)
request if ${url} ~= /^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking)/ then reject(200)
request if ${url} ~= /^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext/ then reject(200)

[MitM]
hostname=www.youtube.com, s.youtube.com
