#!name=汽水音乐去广告补充
#!desc=配合常用的汽水音乐去广告插件使用，只补它们没处理的接口（6 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!tag=去广告
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/ads/ then reject(200)
request if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/location\/info/ then reject(200)
request if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/hashtag\/recommend/ then reject(200)
response if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/me\?/ then response.json.jq("del(.reward_ad_banner)")
response if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/card/ then response.json.jq("del(.preview_guide)")
response if ${url} ~= /^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/search-block/ then response.json.jq("del(.search_chart_block)")

[MitM]
hostname=beta-luna.douyin.com, api.qishui.com, tnc*-*.zijieapi.com
