[Rewrite]
^https?:\/\/gurd\.snssdk\.com\/src\/server\/v3\/package - reject
^https?:\/\/.+\.snssdk\.com\/video\/play\/1\/toutiao\/.+\/mp4 - reject
^https?:\/\/.+\.snssdk.com\/api\/ad\/.+ - reject
^https?:\/\/.+\.snssdk\.com\/motor\/operation\/activity\/display\/config\/V2\/ - reject-200
^https?:\/\/[\w-]+\.snssdk\.com\/.+_ad\/ - reject

[MitM]
hostname=gurd.snssdk.com, i-lq.snssdk.com, reading-hl.snssdk.com
