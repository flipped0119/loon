#!name=番茄小说去广告补充
#!desc=配合常用的番茄小说去广告插件使用，只补它们没处理的接口（5 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!openUrl=https://apps.apple.com/app/id1468454200
#!author=flipped0119
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/96/95/43/9695437f-a41e-5c5d-0e07-17318b52fbf5/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/120x120bb.png
#!date=2026-10-22 19:30:26

[Rewrite]
request if ${url} ~= /^https?:\/\/gurd\.snssdk\.com\/src\/server\/v3\/package/i then reject(404)
request if ${url} ~= /^https?:\/\/.+\.snssdk\.com\/video\/play\/1\/toutiao\/.+\/mp4/i then reject(404)
request if ${url} ~= /^https?:\/\/.+\.snssdk.com\/api\/ad\/.+/i then reject(404)
request if ${url} ~= /^https?:\/\/.+\.snssdk\.com\/motor\/operation\/activity\/display\/config\/V2\//i then reject(200)
request if ${url} ~= /^https?:\/\/[\w-]+\.snssdk\.com\/.+_ad\//i then reject(404)

[MitM]
hostname=gurd.snssdk.com, i-lq.snssdk.com, reading-hl.snssdk.com
