#!name=网易云音乐去广告补充
#!desc=配合常用的网易云音乐去广告插件使用，只补它们没处理的接口（39 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!openUrl=https://apps.apple.com/app/id590338362
#!author=flipped0119
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/2d/84/5f/2d845fe3-b1fc-b57b-d6d7-fe5ae6a468f5/appIconNew-0-0-1x_U007epad-0-1-0-85-220.png/120x120bb.png
#!date=2026-10-22 22:23:38

[Rewrite]
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/content\/activity\/music\/jar\/template\/list/i then reject(200)
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/vipmall\/couponcfg\/get/i then reject(200)
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/comment\/feed\/inserted\/resources/i then reject(200)
request if ${url} ~= /^https?:\/\/yanxuan\.nosdn\.127\.net\/.*\.mp4/i then reject(200)
request if ${url} ~= /^https?:\/\/easyreadfs\.nosdn\.127\.net\/ad-material\//i then reject(200)
request if ${url} ~= /^https:\/\/interface3\.music\.163\.com\/eapi\/vipauth\/app\/auth\/recycle\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/p\.c\.music\.126.net\/.*?jpg$/i then reject(404)
request if ${url} ~= /^https?:\/\/img1.126.net\/.+dpi=\w{7,8}/i then reject(404)
request if ${url} ~= /^https?:\/\/img1.126.net\/channel14\//i then reject(404)
request if ${url} ~= /^https?:\/\/p\d\.music\.126\.net\/\w+==\/\d+\.jpg$/i then reject(404)
request if ${url} ~= /^https?:\/\/statistic\.live\.126\.net\/statics\/report\/common\/form/i then reject(404)

[Script]
response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/home\/framework\/tab/i then script("https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js") with tag="网易云音乐去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/page\/discovery\/resource\/show/i then script("https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js") with tag="网易云音乐去广告补充", requires_body=true
