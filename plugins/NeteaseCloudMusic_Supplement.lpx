response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/search\/chart\/list/ then script("https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js") with tag="网易云音乐去广告补充", requires_body=true
