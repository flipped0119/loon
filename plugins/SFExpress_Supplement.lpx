[Rewrite]
request if ${url} ~= /^https?:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/appVersion\/detectionUpgrade/i then reject(200)
request if ${url} ~= /^https?:\/\/shopic\.sf-express\.com\/crm\/mobile\/common\/flashscreen/i then reject(200)
request if ${url} ~= /^https?:\/\/ucmp\.sf-express\.com\/cx-wechat-query\/query\/info-flow\/reconsitution-list/i then reject(200)
request if ${url} ~= /^https?:\/\/ccsp-egmas\.sf-express\.com\/cx-app-video\/video\/app\/video\/labelClusterList/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/bms\/queryRecommend/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/mcs-mimp-web\.sf-express\.com\/mcs-mimp\/integralPlanet\/getCxAdvertiseList/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/ucmp-static\.sf-express\.com\/proxy\/wxbase\/wxTicket\/wxLiveStreamInfo\?pageNo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/ucmp\.sf-express\.com\/proxy\/operation-platform\/info-flow-adver\/query/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/ucmp\.sf-express\.com\/proxy\/esgcempcore\/memberManage\/memberEquity\/queryRecommendEquity/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/ucmp\.sf-express\.com\/proxy\/esgcempcore\/memberActLengthy\/fullGiveActivityService\/fullGiveInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/ucmp\.sf-express\.com\/cx-wechat-query\/query\/module-config\/query/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/shopic\.sf-express\.com\/index\/home\/get(?>Popup|Layout)/i then reject(404)
request if ${url} ~= /^https?:\/\/shopic\.sf-express\.com\/account\/coupon\/getUserCouponCnt/i then reject(404)

[MitM]
hostname=ccsp-egmas.sf-express.com, shopic.sf-express.com, ucmp.sf-express.com, mcs-mimp-web.sf-express.com, ucmp-static.sf-express.com
