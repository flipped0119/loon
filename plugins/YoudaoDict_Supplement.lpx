#!name=网易有道词典去广告补充
#!desc=配合常用的网易有道词典去广告插件使用，只补它们没处理的接口（6 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/f7/8d/4b/f78d4bad-d4e6-d12e-84b5-78c9b2aa6e5a/AppIcon-0-1x_U007epad-0-11-0-85-220-0.png/120x120bb.png
#!openUrl=https://apps.apple.com/app/id353115739
#!tag=去广告
#!date=2026-10-22 17:24:51
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https?:\/\/dsp-impr2\.youdao\.com\/adload/ then reject(200)
request if ${url} ~= /^https?:\/\/impservice\.dictapp\.youdao\.com\/imp\/request/ then reject_img(200)
request if ${url} ~= /^https?:\/\/oral\.youdao\.com\/oral\/adInfo/ then reject_img(200)
request if ${url} ~= /^https?:\/\/dictvip-business\.youdao\.com\/home\/ad/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/cdke\.youdao\.com\/course\d\/recommend\/dict\/startup/ then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/dict\.youdao\.com\/(homepage\/promotion|course\/tab\/home|homepage\/tile)/ then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/youdao/dict-youdao-ad.js") with tag="网易有道词典去广告补充", requires_body=true, timeout=60

[MitM]
hostname=dsp-impr2.youdao.com, impservice.dictapp.youdao.com, oral.youdao.com, dictvip-business.youdao.com, dict.youdao.com, cdke.youdao.com
