[Rewrite]
request if ${url} ~= /^https?:\/\/ocean\.shuqireader\.com\/api\/ad\/adserver\/.+/i then reject(404)
request if ${url} ~= /^https?:\/\/ocean\.shuqireader\.com\/api\/route\/iosReadPage\/ad.+/i then reject(404)
request if ${url} ~= /^http:\/\/message\.shuqireader\.com\/message\/.+/i then reject(404)
request if ${url} ~= /^http:\/\/.+\.shuqireader\.com\/sapi\/.+/i then reject(404)
request if ${url} ~= /^https?:\/\/message\.shuqireader\.com\/message\/.+/i then reject(404)
request if ${url} ~= /^https?:\/\/.+\.shuqireader\.com\/sapi\/.+/i then reject(404)

[MitM]
hostname=ocean.shuqireader.com, message.shuqireader.com
