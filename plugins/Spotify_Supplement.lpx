#!name=Spotify去广告补充
#!desc=配合常用的Spotify去广告插件使用，只补它们没处理的接口（7 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!openUrl=https://apps.apple.com/app/id324684580
#!author=flipped0119
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/b7/ed/61/b7ed610e-a3ef-4684-4862-935158e58f07/AppIcon-0-0-1x_U007epad-0-1-0-0-85-220.png/120x120bb.png
#!date=2026-10-22 19:30:26

[Rewrite]
request if ${url} ~= /^https?:\/\/spclient.wg.spotify.com\/(ad-logic|ads|.+ad_slot|.+banners|.+canvases|.+cards|.+crashlytics|.+doubleclick.net|.+enabled-tracks|.+promoted_offer)/i then reject_img(200)
request if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/.+doubleclick/i then reject_img(200)
request if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/.+event/i then reject(200)
request if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/.+promoted/i then reject_img(200)
request if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/.+sponsored/i then reject_img(200)
request if ${url} ~= /^https?:\/\/(?>gae2-spclient|guc3-spclient|spclient\.wg)\.spotify\.com(:443)?\/(?>ad-logic|ads|.+ad_slot|.+banners|.+canvases|.+cards|.+crashlytics|.+doubleclick.net|.+enabled-tracks|.+event|.+sponsored|.+promoted)/i then reject_img(200)
request if ${url} ~= /^https?:\/\/(?>gae2-spclient|guc3-spclient|spclient\.wg)\.spotify\.com(:443)?\/artistview\/v1\/artist\/(.*)&platform=iphone/i then redirect(302, "https://$1.spotify.com/artistview/v1/artist/$2&platform=ipad")

[MitM]
hostname=spclient.wg.spotify.com, gae2-spclient.spotify.com, guc3-spclient.spotify.com
