#!name=知乎去广告补充
#!desc=配合常用的知乎去广告插件使用，只补它们没处理的接口（75 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/8f/48/18/8f4818e2-f096-eff0-e355-e4a89e6bc2c3/AppIcon-0-0-1x_U007emarketing-0-7-0-sRGB-85-220.png/120x120bb.png
#!openUrl=https://apps.apple.com/app/id432274380
#!tag=去广告
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https?:\/\/2402:4e00:1200:ed00:0:9089:6dac:96b6/ then reject(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/ab\/api\/v1\/products\/zhihu\/platforms\/ios\/config/ then reject(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/brand\/question\/\d+\/card\?/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d+\/brand\/question\/\d+\/card\?/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/moments\/tab_v2/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/(notifications\/v\d\/count)/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d\/answers\/\d+\/recommendations/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/me\/guides/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/moments\/recent/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/api\/v4\/ecom_data\/config/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/content-distribution-core\/bubble\/common\/settings/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/feed\/render\/revisit\/current_reading/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/feed\/render\/revisit\/tag_config/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d\/articles\/\d+\/recommendation/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/api\/v4\/profile\/cards/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/drama\/hot-drama-list/ then reject(404)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v4\/topics\/rank_list\/question\/\d+\/related/ then reject(404)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v4\/search\/related_queries\/answer\// then reject_dict(200)
request if ${url} ~= /^http:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,4}(:\d+)?\/v2\/resolv/ then reject(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/root\/window/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/appview\/v\d\/zhmore/ then reject(200)
^http:\/\/.+/\?tk=9901afb195dcf9a34db6088a4a221dba38b3d980e4db86009f8a08be4d4099ee323f6e7f03b881db21133b1bf2ae5bc5 - reject
^http:\/\/.+\/vmind\.qqvideo\.tc\.qq\.com\/.+\.mp4 - reject
^http:\/\/.+\/vmind\.qqvideo\.tc\.qq\.com\/.+mp4 - reject-dict
^https?:\/\/static\.zhihu\.com\/[^\/]+\/(main|column)\.signflow\.[^.]+.js - reject
^https?:\/\/www\.zhihu\.com\/api\/v4\/community-ad\/ - reject
^https?:\/\/www\.zhihu\.com\/terms\/privacy\/confirm - reject-img
^https?:\/\/api\.zhihu\.com\/fringe\/ad - reject
^https?:\/\/api\.zhihu\.com\/ad - reject
^https?:\/\/api\.zhihu\.com\/appview\/api\/v\d\/answers\/\d+\/recommendations - reject
^https?:\/\/api\.zhihu\.com\/\w+\/\d+\/comments\/featured-comment-ad - reject
^https?+:\/\/api\.zhihu\.com\/(?>launch|real_time) - reject-200
^https?+:\/\/www\.zhihu\.com\/api\/v4\/cmmunity-ad - reject-200
^https?:\/\/(api|www)\.zhihu\.com\/.*?(featured-comment-ad|recommendations|community-ad) - reject-img
^https?:\/\/api\.zhihu\.com\/market\/popover - reject-img
^https:\/\/api\.zhihu\.com\/prague\/related_suggestion_native\/feed\? reject-dict
^https:\/\/api\.zhihu\.com\/v5\.1\/topics\/answer\/\d+\/relation reject-dict
^https:\/\/appcloud2\.zhihu\.com\/v3\/resource\?group_name=mp reject-dict
^https:\/\/link\.zhihu\.com\/\?target=(?:https?)?(?:%3A|:)?(?:\/\/|%2F%2F)?(.*) 302 http://$1
^https:\/\/api\.zhihu\.com\/distribute\/rhea\/qa_ad_card\/h5\/recommendation\? reject-dict
^https:\/\/www\.zhihu\.com\/api\/v4\/hot_recommendation reject
^https:\/\/www\.zhihu\.com\/api\/v4\/mcn\/v2\/linkcards\? reject
^https:\/\/www\.zhihu\.com\/api\/v4/(?:answers|questions)\/\d+/related-readings reject
^https:\/\/www\.zhihu\.com\/commercial_api\/banners_v3\/mobile_banner reject
^https:\/\/zhuanlan\.zhihu\.com\/api\/articles\/\d+\/recommendation reject
^https:\/\/zhstatic\.zhihu\.com\/brand-ad reject
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/v\d\.\d\/topics\/answer\/\d+\/relation/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/commercial_api\/banners_v\d\/mobile_banner/ then reject(404)

[Script]
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/commercial_api.*launch_v2/ then script("https://ddgksf2013.top/scripts/zhihu.ads.js") with tag="知乎去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/bazaar\/vip_tab\/tabs/ then script("https://ddgksf2013.top/scripts/zhihu.ads.js") with tag="知乎去广告补充", requires_body=true
