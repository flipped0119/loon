response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/bazaar\/vip_tab\/header/ then script("https://ddgksf2013.top/scripts/zhihu.ads.js") with tag="知乎补充", requires_body=true
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/next-data/ then script("https://ddgksf2013.top/scripts/zhihu.ads.js") with tag="知乎补充", requires_body=true
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/(v4\/)?questions\/\d+\/feeds/ then script("https://ddgksf2013.top/scripts/zhihu.ads.js") with tag="知乎补充", requires_body=true
response if ${url} ~= /^https?:\/\/www\.zhihu\.com\/appview\/v2\/answer\// then script("https://ddgksf2013.top/scripts/zhihu.ads.js") with tag="知乎补充", requires_body=true
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/bazaar\/vip_tab\/modules/ then script("https://ddgksf2013.top/scripts/zhihu.ads.js") with tag="知乎补充", requires_body=true
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/user-credit\/basis/ then script("https://ddgksf2013.top/scripts/zhihu.ads.js") with tag="知乎补充", requires_body=true
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/notifications\/v3\/(message|timeline\/entry\/system_message)/ then script("https://ddgksf2013.top/scripts/zhihu.ads.js") with tag="知乎补充", requires_body=true
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/moments_v3/ then script("https://ddgksf2013.top/scripts/zhihu.ads.js") with tag="知乎补充", requires_body=true
response if ${url} ~= /https:\/\/api.zhihu.com\/search\/hot_search/ then script("https://ddgksf2013.top/scripts/zhihu.ads.js") with tag="知乎补充", requires_body=true

