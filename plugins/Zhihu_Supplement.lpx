#!name=知乎去广告补充
#!desc=配合常用的知乎去广告插件使用，只补它们没处理的接口（36 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!tag=去广告
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https?:\/\/118\.89\.204\.198/ then reject(200)
request if ${url} ~= /^https?:\/\/103\.41\.167\.237/ then reject(200)
request if ${url} ~= /^https?:\/\/2402:4e00:1200:ed00:0:9089:6dac:96b6/ then reject(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/ab\/api\/v1\/products\/zhihu\/platforms\/ios\/config/ then reject(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/brand\/question\/\d+\/card\?/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d+\/brand\/question\/\d+\/card\?/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/moments\/tab_v2/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/(notifications\/v\d\/count)/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d\/answers\/\d+\/recommendations/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/me\/guides/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/moments\/recent/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/api\/v4\/ecom_data\/config/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/content-distribution-core\/bubble\/common\/settings/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/feed\/render\/revisit\/current_reading/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/feed\/render\/revisit\/tag_config/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v\d\/articles\/\d+\/recommendation/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/api\/v4\/profile\/cards/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/drama\/hot-drama-list/ then reject(404)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v4\/topics\/rank_list\/question\/\d+\/related/ then reject(404)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/api\/v4\/search\/related_queries\/answer\// then reject_dict(200)
request if ${url} ~= /^http:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,4}(:\d+)?\/v2\/resolv/ then reject(200)
request if ${url} ~= /^https?:\/\/api\.zhihu\.com\/root\/window/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.zhihu\.com\/appview\/v\d\/zhmore/ then reject(200)
response if ${url} ~= /^https?:\/\/.*zhihu.com\/(answers|articles)\/v\d/ then response.json.jq(".third_business |= del(.related_queries, .ring)")

[Script]
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/commercial_api.*launch_v2/ then script("https://ddgksf2013.top/scripts/zhihu.ads.js") with tag="知乎补充", requires_body=true
response if ${url} ~= /^https?:\/\/api\.zhihu\.com\/bazaar\/vip_tab\/tabs/ then script("https://ddgksf2013.top/scripts/zhihu.ads.js") with tag="知乎补充", requires_body=true
