#!name=小红书去广告补充
#!desc=配合常用的小红书去广告插件使用，只补它们没处理的接口（16 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/4f/54/88/4f54884e-c820-aa94-5797-c6b69c27ed3a/AppIcon-0-0-1x_U007epad-0-11-0-85-220.png/120x120bb.png
#!openUrl=https://apps.apple.com/app/id741292507
#!tag=去广告
#!date=2026-10-22 16:38:18
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/notes\/recommend_info\?/ then reject(200)
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash/ then reject(200)
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/gslb/ then reject(200)
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/httpdns/ then reject(200)
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/(tag\/)?ads/ then reject(200)
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/v\d+\/stateReport/ then reject(200)
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/data\/native\/matrix_switches/ then reject(200)
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/user\/teenager\/status/ then reject(200)
request if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/guide\/home_guide/ then reject(200)
request if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/nike\/v\d\/update\/check/ then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/tabfeed/ then script("https://ddgksf2013.top/scripts/redbook.ads.js") with tag="小红书去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/video\/save/ then script("https://ddgksf2013.top/scripts/redbook.ads.js") with tag="小红书去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/redtube\?/ then script("https://ddgksf2013.top/scripts/redbook.ads.js") with tag="小红书去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/homefeed\/categories/ then script("https://ddgksf2013.top/scripts/redbook.ads.js") with tag="小红书去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/user\/followings\/followfeed/ then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/xiaohongshu.js") with tag="小红书去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/recommend\/user\/follow_recommend\?/ then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/xiaohongshu.js") with tag="小红书去广告补充", requires_body=true

[MitM]
hostname=edith.xiaohongshu.com
