#!name=什么值得买去广告补充
#!desc=配合常用的什么值得买去广告插件使用，只补它们没处理的接口（5 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!tag=去广告
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/wiki_related_modul/ then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/.*zdmimg\.com\/cpm\/api\/v\d\/advert_distribution\/get_all_advertise/ then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/smzdm_json.js") with tag="什么值得买补充", requires_body=true
response if ${url} ~= /^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/article_releated_modul/ then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/smzdm_json.js") with tag="什么值得买补充", requires_body=true
response if ${url} ~= /^https?:\/\/baike-api\.smzdm\.com\/home_v3\/list/ then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/smzdm_json.js") with tag="什么值得买补充", requires_body=true
response if ${url} ~= /^https?:\/\/zhiyou\.m\.smzdm\.com\/user\/vip\/ajax_get_banner/ then script("https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/smzdm_json.js") with tag="什么值得买补充", requires_body=true

[MitM]
hostname=haojia.m.smzdm.com, *.zdmimg.com, baike-api.smzdm.com, zhiyou.m.smzdm.com
