#!name=小象超市去广告补充
#!desc=配合常用的小象超市去广告插件使用，只补它们没处理的接口（23 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!openUrl=https://apps.apple.com/app/id1444411068
#!author=flipped0119
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/58/f3/31/58f331f7-80fb-db5d-a742-096caec94228/AppIcon-0-0-1x_U007emarketing-0-3-0-85-220.png/120x120bb.png
#!date=2026-10-22 19:30:26

[Rewrite]
request if ${url} ~= /^https?:\/\/peisongapi\.meituan\.com\/client\/getInitiateImage/i then reject(200)
request if ${url} ~= /^https?:\/\/.*\.meituan\.com\/api\/v\d\/(openscreen\?ad|appstatus\?ad|loadInfo\?|startpicture)/i then reject(200)
request if ${url} ~= /^https:\/\/richmanrules\.ksedt\.com\/intellectWaterfall(Bidding)?\/find/i then reject(404)
request if ${url} ~= /^https?:\/\/www\.meituan\.com\/api\/v\d\/appstatus\?/i then reject(404)
request if ${url} ~= /^https?:\/\/apimobile\.meituan\.com\/appupdate\/mach\/checkUpdate?/i then reject(404)
request if ${url} ~= /^https?:\/\/p\.meituan\.com\/api\/privacy\/config/i then reject(404)
request if ${url} ~= /^https?:\/\/rms\.meituan\.com\/api\/v\d\/rmsmina\/c\/queryWechatAdvertisement/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/cdb\.meituan\.com\/marketing\/source\/getPageSlotList/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/apimobile\.meituan\.com\/appupdate/i then reject(404)
request if ${url} ~= /^https?:\/\/apimobile\.meituan\.com\/group\/v\d\/recommend\/unity\/recommends/i then reject(404)
request if ${url} ~= /^https?:\/\/portal-portm\.meituan\.com\/horn_ios/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/sqt\.meituan\.com\/s\/gateway\/mweb\/api\/marketingResource\/show/i then reject(404)
request if ${url} ~= /^https?:\/\/gouche\.ksedt\.com\/config\/popup\//i then reject_dict(200)
request if ${url} ~= /^https?:\/\/op\.ksedt\.com\/jxedtLive\/liveIntroduceResource/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/rms\.meituan\.com\/api\/v\d\/rmsmina\/c\/selectpopuptoshow/i then reject_dict(200)
response if ${url} ~= /^https?:\/\/rms\.meituan\.com\/api\/v\d\/rmsmina\/c\/queryPortalInfo/i then response.json.jq(".data.modules |= map(select(.data.advType != true and .name != \"float-window\"))")
request if ${url} ~= /^https?:\/\/npay\.meituan\.com\/conch\/flow\/mypage-wallet-info/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/npay\.meituan\.com\/conch\/walletv\d\/wechat-pop-window/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/web\.meituan\.com\/newUser\/returnMoney\/popWindow/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/web\.meituan\.com\/api\/miniprogram\/my\/(?>novelZone|resources)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/peppermall\.meituan\.com\/user\/popup\/list/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/web\.meituan\.com\/api\/miniprogram\/tabbar\/all\/query/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/meituanwm.js") with tag="小象超市去广告补充", requires_body=true
response if ${url} ~= /^https?:\/\/web\.meituan\.com\/api\/miniprogram\/index\/aggregate/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/meituanwm.js") with tag="小象超市去广告补充", requires_body=true

[MitM]
hostname=peisongapi.meituan.com, www.meituan.com, wmapi.meituan.com, richmanrules.ksedt.com, apimobile.meituan.com, p.meituan.com, rms.meituan.com, cdb.meituan.com, portal-portm.meituan.com, sqt.meituan.com, gouche.ksedt.com, op.ksedt.com, npay.meituan.com, web.meituan.com, peppermall.meituan.com
