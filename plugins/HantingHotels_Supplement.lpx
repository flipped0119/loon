#!name=华住会去广告补充
#!desc=配合常用的华住会去广告插件使用，只补它们没处理的接口（6 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!openUrl=https://apps.apple.com/app/id556808349
#!author=flipped0119
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/eb/fc/6c/ebfc6c1a-e378-7209-042e-253c6979fdb2/AppIcon-0-1x_U007ephone-0-11-0-85-220-0.png/120x120bb.png
#!date=2026-10-22 19:30:26

[Rewrite]
request if ${url} ~= /^https?:\/\/appapi\.huazhu\.com:\d{4}\/client\/app\/getAppStartPage\//i then reject(200)
request if ${url} ~= /^https:\/\/api-fouth-mem\.huazhu\.com\/api\/rights\/bannerList/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/hweb-hotel\.huazhu\.com\/home\/queryRecommond/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/hweb-manager\.huazhu\.com\/bundle\/upgrade\/check/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/hweb-manager\.huazhu\.com\/hotels\/ad\//i then reject_dict(200)
request if ${url} ~= /^https?:\/\/hweb-manager\.huazhu\.com\/start\/getAppStartPage/i then reject(404)

[MitM]
hostname=appapi.huazhu.com, api-fouth-mem.huazhu.com, hweb-hotel.huazhu.com, hweb-manager.huazhu.com
