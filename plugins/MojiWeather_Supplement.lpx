#!name=墨迹天气去广告补充
#!desc=配合常用的墨迹天气去广告插件使用，只补它们没处理的接口（11 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!openUrl=https://apps.apple.com/app/id434209233
#!author=flipped0119
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/flipped0119/loon
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/bb/08/26/bb082641-37e3-9346-4e66-28b6a2b0375b/AppIcon-0-0-1x_U007ephone-0-1-0-85-220.png/120x120bb.png
#!date=2026-10-22 22:23:38

[Rule]
DOMAIN-SUFFIX,adlaunch.moji.com,REJECT
DOMAIN,ad.api.moji.com,REJECT
DOMAIN,mcmn.api.moji.com,REJECT
DOMAIN,mcs.api.moji.com,REJECT
DOMAIN,mmqn.api.moji.com,REJECT
DOMAIN,v1.log.moji.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/.*api\.moji\.com\/shortvideo/i then reject(200)
request if ${url} ~= /^https?:\/\/.*api\.moji\.com\/json\/advertising_goods/i then reject(200)
request if ${url} ~= /^https?:\/\/.*api\.moji\.com\/forum/i then reject(200)
request if ${url} ~= /^https?:\/\/.*api\.moji\.com\/user\/dynamic_v\d\/json\/someone_interest/i then reject(200)
request if ${url} ~= /^https?:\/\/cdn\.moji\.com\/(adoss|adlink)\//i then reject(200)

[MitM]
hostname=*.api.moji.com, cdn.moji.com
