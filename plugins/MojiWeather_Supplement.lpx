#!name=墨迹天气去广告补充
#!desc=配合常用的墨迹天气去广告插件使用，只补它们没处理的接口（6 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!tag=去广告
#!loon_version=3.5.1(998)

[Rule]
DOMAIN-SUFFIX,adlaunch.moji.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/.*api\.moji\.com\/shortvideo/ then reject(200)
request if ${url} ~= /^https?:\/\/.*api\.moji\.com\/json\/advertising_goods/ then reject(200)
request if ${url} ~= /^https?:\/\/.*api\.moji\.com\/forum/ then reject(200)
request if ${url} ~= /^https?:\/\/.*api\.moji\.com\/user\/dynamic_v\d\/json\/someone_interest/ then reject(200)
request if ${url} ~= /^https?:\/\/cdn\.moji\.com\/(adoss|adlink)\// then reject(200)

[MitM]
hostname=*.api.moji.com, cdn.moji.com
