#!name=百度网盘去广告补充
#!desc=配合常用的百度网盘去广告插件使用，只补它们没处理的接口（17 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!tag=去广告
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/act\/v\d\/(bchannel|welfare)\/list/ then reject(200)
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/rest\/.*\/pcs\/ad/ then reject(200)
request if ${url} ~= /^https:\/\/pan\.baidu\.com\/feed\/hotlist/ then reject(200)
request if ${url} ~= /^https:\/\/pan\.baidu\.com\/queryintent\/queryhint/ then reject(200)
request if ${url} ~= /^https:\/\/pan\.baidu\.com\/coins\/center\/notice/ then reject(200)
request if ${url} ~= /^https:\/\/pan\.baidu\.com\/recommend\/shortseries\/list/ then reject_dict(200)
^https:\/\/pan\.baidu\.com\/pmall\/order\/privilege\/info - reject
^https:\/\/pan\.baidu\.com\/api\/useractivity\/activity - reject
^http:\/\/pan\.baidu\.com\/act\/.+\/bchannel\/list - reject
^https:\/\/pan\.baidu\.com\/api\/certuser\/get - reject
^https:\/\/pan\.baidu\.com\/component\/view\/(1510|1130)\?vip - reject
^https?:\/\/pan\.baidu\.com\/act\/.+\/bchannel\/list reject
request if ${url} ~= /^https?:\/\/pan\.baidu\.com\/buy\/ad\// then reject(200)

[Script]
response if ${url} ~= /^https:\/\/pan\.baidu\.com\/rest\/.*\/membership\/user\?method=gamecenter/ then script("https://ddgksf2013.top/scripts/bdpan.ads.js") with tag="百度网盘去广告补充", requires_body=true
response if ${url} ~= /^https:\/\/pan\.baidu\.com\/feed\/cardinfos/ then script("https://ddgksf2013.top/scripts/bdpan.ads.js") with tag="百度网盘去广告补充", requires_body=true
http-response https:\/\/pan\.baidu\.com\/rest\/2\.0\/membership\/user requires-body=1,script-path=https://raw.githubusercontent.com/NobyDa/Script/master/Surge/JS/BaiduCloud.js, tag=百度网盘去广告补充
response if ${url} ~= /^https?:\/\/pan\.baidu\.com\/rest\/\d\.\d\/membership\/user/ then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/baiduPan.js") with tag="百度网盘去广告补充", requires_body=true

[MitM]
hostname=pan.baidu.com
