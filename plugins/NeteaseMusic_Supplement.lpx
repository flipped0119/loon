#!name=网易云音乐去广告补充
#!desc=配合常用的网易云音乐去广告插件使用，只补它们没处理的接口（25 条）。请排在其他去广告插件之后：Loon 同一请求只执行第一条命中的脚本。
#!author=flipped0119
#!homepage=https://github.com/flipped0119/loon
#!tag=去广告
#!loon_version=3.5.1(998)

[Rewrite]
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/content\/activity\/music\/jar\/template\/list/ then reject(200)
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/sp\/flow\/popup\/query/ then reject(200)
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/vipmall\/couponcfg\/get/ then reject(200)
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/w?eapi\/(resource-exposure\/)?activity/ then reject(200)
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/comment\/feed\/inserted\/resources/ then reject(200)
request if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/resource-exposure\/config/ then reject(200)

[Script]
response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/home\/framework\/tab/ then script("https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js") with tag="网易云音乐补充", requires_body=true
response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/page\/discovery\/resource\/show/ then script("https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js") with tag="网易云音乐补充", requires_body=true
response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/page\/rcmd\/resource\/show/ then script("https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js") with tag="网易云音乐补充", requires_body=true
response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/ios\/upgrade\/get/ then script("https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js") with tag="网易云音乐补充", requires_body=true
response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/search\/rcmd\/keyword\/get/ then script("https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js") with tag="网易云音乐补充", requires_body=true
response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/search\/chart\/list/ then script("https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js") with tag="网易云音乐补充", requires_body=true
response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/search\/chart\/detail/ then script("https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js") with tag="网易云音乐补充", requires_body=true
response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/search\/suggest\/keyword\/get/ then script("https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js") with tag="网易云音乐补充", requires_body=true
response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/search\/specialkeyword\/get/ then script("https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js") with tag="网易云音乐补充", requires_body=true
response if ${url} ~= /^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/position\/show\/resource/ then script("https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js") with tag="网易云音乐补充", requires_body=true
